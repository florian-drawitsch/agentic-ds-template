{%- set vendors = (['claude', 'codex', 'gemini'] | select('in', agent_harnesses) | list)[:2] -%}
# Ticket factory controller (ADR-0033 of agentic-ds-template). Omitted keys use the defaults
# shown in comments. Changes to this file always need a human merge (protected path).

# GitHub project board that mirrors the label states. By default `task factory:init` uses
# the board named "<repository> factory" under the repository's owner and creates it when
# missing. Set a URL only to use another board.
# project = "https://github.com/users/<owner>/projects/<number>"

# Mode (ADR-0033). "dark" (default): a plan needs no approval unless triage rates the ticket
# risk high, a maintainer adds the label factory:lit, or the plan has an open question.
# "lit": every plan waits in Plan review until a maintainer approves it.
# mode = "dark"
# max_plan_review = 3   # stop planning while this many plans wait for a person

# One model per stage, as "<model id>" or "<model id>:<effort>". A model is used only when it
# fits the harness selected under [deliver] or the stage's vendor.
# [models]   (a table: add it at the end of this file)
# triage = "gemini-4-hydrogen"
# plan = "opus:high"
# implement = "sonnet:medium"
# verify = "gemini-4-carbon"

# Work in progress: issues being implemented at once, and verified PRs waiting for a merge.
# Deliveries run one at a time today: a tick runs the delivery to its end, so a value above 1
# has no effect until deliveries run as separate jobs.
# max_in_progress = 1
# max_verified = 3
# max_repair_cycles = 2
# review_wait_minutes = 30

# Spend caps in USD per UTC day and per calendar week (Monday to Sunday, UTC).
# daily_cap_usd = 20.0
# weekly_cap_usd = 100.0

# Check runs that must pass before a PR counts as verified: the CI job.
required_checks = ["Lint, types, contracts, tests and docs"]

# Pull requests touching these paths always go to a human.
# protected_paths = ["AGENTS.md", "CLAUDE.md", "factory.toml", "deliver.toml", ".claude/",
#                    ".codex/", "scripts/agent/", ".github/", "infra/"]

# Bots allowed to release tickets with `factory:ready`.
# trusted_bots = []

[deliver]
# The implementer; the verifier is always the other vendor.
harness = "{{ vendors[0] }}"
reviewer = "{{ vendors[1] }}"
max_cost = 10.0
