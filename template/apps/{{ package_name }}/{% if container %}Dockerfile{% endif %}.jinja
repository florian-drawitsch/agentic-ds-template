# Build from the repository root with `task {{ package_name }}:docker:build`.
FROM python:{{ python_version }}-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.9 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY apps ./apps
# Shared workspace libraries are included when present.
COPY packages ./packages
RUN uv sync --frozen --no-dev --no-default-groups --package {{ package_name }}

ENTRYPOINT ["uv", "run", "--no-sync", "--package", "{{ package_name }}", "{{ package_name }}"]
