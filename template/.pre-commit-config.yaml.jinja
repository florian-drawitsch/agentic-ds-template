# Git hooks, run by prek (https://github.com/j178/prek). `task lint` runs them on all files.
default_install_hook_types: [pre-commit, commit-msg]

repos:
  # Secret scan. `task deliver` also scans the commits it publishes.
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.24.2
    hooks:
      - id: gitleaks
        args: [--redact]

  - repo: builtin
    hooks:
      - id: trailing-whitespace
        args: [--markdown-linebreak-ext=md]
        # Claude Code's sandbox never lets agents write agent and IDE config, so fixers skip it.
        exclude: ^(\.(claude|codex|agents|vscode|idea)/|\.mcp\.json$)
      - id: end-of-file-fixer
        # Claude Code's sandbox never lets agents write agent and IDE config, so fixers skip it.
        exclude: ^(\.(claude|codex|agents|vscode|idea)/|\.mcp\.json$)
      - id: mixed-line-ending
        # Claude Code's sandbox never lets agents write agent and IDE config, so fixers skip it.
        exclude: ^(\.(claude|codex|agents|vscode|idea)/|\.mcp\.json$)
      - id: check-yaml
      - id: check-toml
      - id: check-json
      - id: check-merge-conflict
      - id: check-added-large-files
        # Lockfiles are generated and must be committed, whatever their size.
        exclude: (^|/)(uv\.lock|package-lock\.json)$
      - id: detect-private-key

  - repo: local
    hooks:
      - id: ruff-format
        name: ruff format
        entry: uv run --all-packages ruff format
        language: system
        types_or: [python, pyi, jupyter]
        require_serial: true

      - id: ruff-check
        name: ruff check
        entry: uv run --all-packages ruff check --fix --exit-non-zero-on-fix
        language: system
        types_or: [python, pyi, jupyter]
        require_serial: true

      - id: ty
        name: ty
        entry: uv run --all-packages ty check
        language: system
        types: [python]
        pass_filenames: false

      - id: import-linter
        name: import contracts
        entry: >-
          bash -O nullglob -c 'for config in apps/*/pyproject.toml packages/*/pyproject.toml;
          do grep -q "^\[tool\.importlinter\]" "$config" || continue;
          uv run --all-packages lint-imports --config "$config" || exit; done'
        language: system
        files: (^|/)(.*\.py|pyproject\.toml)$
        pass_filenames: false

      - id: workspace
        name: workspace app boundaries
        entry: uv run --all-packages python scripts/check_workspace.py
        language: system
        always_run: true
        pass_filenames: false

      - id: uv-lock
        name: uv.lock is current
        entry: uv lock --check
        language: system
        files: (^|/)(pyproject\.toml|uv\.lock)$
        pass_filenames: false
{%- if notebooks %}

      - id: nbstripout
        name: strip notebook outputs
        entry: uv run --all-packages nbstripout
        language: system
        types: [jupyter]
{%- endif %}
{%- if agent_harnesses %}

      - id: mermaid-style
        name: mermaid house style
        entry: uv run --all-packages --script scripts/agent/check_mermaid.py
        language: system
        types: [markdown]
{%- endif %}
{%- if ci == "github" %}

      - id: zizmor
        name: zizmor (workflow security)
        entry: uv run --all-packages zizmor --no-progress
        language: system
        files: ^\.github/workflows/
{%- endif %}

      - id: commitizen
        name: conventional commit message
        entry: uv run --all-packages cz check --allow-abort --commit-msg-file
        language: system
        stages: [commit-msg]
