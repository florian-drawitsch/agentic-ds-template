{%- set hexagonal = architecture == "hexagonal" -%}
{%- set p = package_name -%}
version: '3'

silent: true

dotenv: ['.env']

includes:
  docs: ./taskfiles/docs.yml
{%- if agent_harnesses %}
  deliver:
    taskfile: ./taskfiles/deliver.yml
    aliases: [agent]
{%- endif %}
{%- if factory %}
  factory: ./taskfiles/factory.yml
{%- endif %}
  {{ p }}:
    taskfile: ./apps/{{ p }}/Taskfile.yml
    dir: .
{%- if infrastructure == 'azure' %}
  infra:
    taskfile: ./taskfiles/infra.yml
    vars:
      PROJECT: {{ project_name }}
      LOCATION: {{ azure_location }}
      APP: {{ p }}
{%- endif %}

tasks:
  setup:
    desc: Install the environment and the git hooks
    cmds:
      - uv sync --all-packages --locked
      - uv run --all-packages prek install --install-hooks --hook-type pre-commit --hook-type commit-msg
{%- if notebooks %}
      - uv run --all-packages python -m ipykernel install --sys-prefix --name {{ p }} --display-name {{ project_name }}
{%- endif %}
{%- if factory %}
      - uv run --script scripts/agent/factory.py init --skip-unavailable
{%- endif %}

  test:
    desc: Run the test suite
    cmds:
      - uv run --all-packages pytest {{ '{{.CLI_ARGS}}' }}

  test-fast:
    desc: Run pytest without coverage, for focused checks while iterating, e.g. `task test-fast -- apps/{{ p }}/tests/unit`
    cmds:
      - uv run --all-packages pytest --no-cov -q {{ '{{.CLI_ARGS}}' }}

  lint:
    desc: Run every git hook on tracked and untracked files without staging them
    cmds:
      - uv run --all-packages python scripts/run_hooks.py

  check:
    desc: 'Merge gate: lint, types, import contracts and tests{{ ", including infrastructure tests" if infrastructure == "azure" else "" }}'
    cmds:
      - task: lint
      - task: test
{%- if infrastructure == 'azure' %}
      - task: infra:test
{%- endif %}
{%- if tracking == "mlflow" %}

  mlflow:
    desc: Serve the MLflow UI for runs tracked in data/09_tracking
    vars:
      PORT: '{{ '{{.PORT | default "5000"}}' }}'
    cmds:
      - uv run --all-packages mlflow ui --backend-store-uri sqlite:///data/09_tracking/mlflow.db --port {{ '{{.PORT}}' }}
{%- endif %}

  update-template:
    desc: Pull the latest template version; resolve conflicts, then run task check
    preconditions:
      - sh: test -z "$(git status --porcelain)"
        msg: Commit or stash your changes first
    cmds:
      - uvx copier update --trust --conflict inline {{ '{{.CLI_ARGS}}' }}

  clean:
    desc: Preview, confirm, then delete untracked and ignored files except data/ and .env
    cmds:
      - git clean -ndx -e /data -e "/.env*"
      - task: _clean

  _clean:
    internal: true
    prompt: This permanently deletes the files listed above. Continue?
    cmds:
      - git clean -fdx -e /data -e "/.env*"
