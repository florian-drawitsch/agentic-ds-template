{%- from 'includes/permissions.jinja' import allow_commands, deny_commands, keychain_commands with context -%}
{%- set hook = 'uv run --script "${CLAUDE_PROJECT_DIR}/scripts/agent/' -%}
{%- set allow = [] -%}
{%- for cmd in allow_commands + keychain_commands %}{% set _ = allow.append("Bash(" ~ (cmd | join(" ")) ~ " *)") %}{% endfor -%}
{%- set deny = ["Read(./.env)", "Edit(./uv.lock)"] -%}
{%- for rule in deny_commands %}{% set _ = deny.append("Bash(" ~ (rule.cmd | join(" ")) ~ " *)") %}{% endfor -%}
{{ {
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {"allow": allow, "deny": deny},
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": hook ~ 'status.py"'}]}],
    "PreToolUse": [{
      "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit",
      "hooks": [{"type": "command", "command": hook ~ 'guard.py"'}]
    }],
    "PostToolUse": [{
      "matcher": "Edit|Write|MultiEdit",
      "hooks": [{"type": "command", "command": hook ~ 'format_changed.py"'}]
    }],
    "Stop": [{"hooks": [{"type": "command", "command": hook ~ 'deliver.py" hook', "timeout": 1800}]}]
  },
  "extraKnownMarketplaces": {
    "agentic-ds-template": {
      "source": {"source": "github", "repo": marketplace_repo, "ref": marketplace_ref}
    }
  },
  "enabledPlugins": {
    "superpowers@agentic-ds-template": true,
    "project@agentic-ds-template": true
  },
  "attribution": {"commit": "", "pr": ""}
} | tojson(indent=2) }}
