from pathlib import Path

import pytest
from fastapi.testclient import TestClient

from {{ package_name }}{{ '.entrypoints' if architecture == 'hexagonal' else '' }} import api


def test_health() -> None:
    assert TestClient(api.app).get("/health").json() == {"status": "ok"}


def test_report_is_404_before_the_first_run(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setattr(api, "REPORT_PATH", tmp_path / "missing.json")
    assert TestClient(api.app).get("/report").status_code == 404


def test_report_returns_the_latest_report(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    path = tmp_path / "latest.json"
    path.write_text('{"mae": 1.0}')
    monkeypatch.setattr(api, "REPORT_PATH", path)
    assert TestClient(api.app).get("/report").json() == {"mae": 1.0}
