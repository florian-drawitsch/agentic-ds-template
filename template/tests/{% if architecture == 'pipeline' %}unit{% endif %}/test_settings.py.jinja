from pathlib import Path
{%- if config == 'hydra' %}
from typing import Any, cast

from hydra import compose, initialize_config_dir
from omegaconf import OmegaConf

from {{ package_name }}.cli import CONFIG_DIR
from {{ package_name }}.settings import settings_from_mapping


def test_hydra_config_composes_into_settings() -> None:
    with initialize_config_dir(config_dir=str(CONFIG_DIR), version_base=None):
        cfg = compose(config_name="config", overrides=["params.target=y"])
    settings = settings_from_mapping(
        cast("dict[str, Any]", OmegaConf.to_container(cfg, resolve=True))
    )
    assert settings.params["target"] == "y"
    assert settings.catalog["raw"] == Path("data/01_raw/input.csv")
{%- else %}

from {{ package_name }}.cli import CONFIG_DIR
from {{ package_name }}.settings import load_settings


def test_default_config_loads() -> None:
    settings = load_settings(CONFIG_DIR / "config.toml")
    assert settings.params["target"] == "target"
    assert settings.catalog["report"] == Path("data/08_reporting/latest.json")
{%- endif %}
