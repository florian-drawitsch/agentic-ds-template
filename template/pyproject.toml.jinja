[dependency-groups]
dev = [{% if notebooks %}"ipykernel", "plotly"{% endif %}]
test = ["pytest", "pytest-cov"{% if "api" in interfaces %}, "httpx"{% endif %}]
lint = [
    "commitizen",
    "import-linter",
{%- if notebooks %}
    "nbstripout",
{%- endif %}
    "prek",
    "ruff",
    "ty",
{%- if ci == "github" %}
    "zizmor",
{%- endif %}
]
docs = [
    "furo",
    "myst-parser",
    "pylint",
    "sphinx",
    "sphinx-autoapi",
    "sphinx-autobuild",
    "sphinxcontrib-mermaid",
]

[tool.uv.workspace]
members = ["apps/*", "packages/*"]

[tool.uv]
default-groups = "all"
# Supply-chain cooldown: resolve only releases older than seven days (ADR-0012 of the template).
exclude-newer = "7 days"

[tool.ruff]
line-length = 100
# Copied from the template's plugin and updated with it; do not reformat them here.
extend-exclude = ["scripts/agent/deliver.py", "scripts/agent/cross_review.py", "scripts/agent/create_pr.py", "scripts/agent/pr_findings.py", "scripts/agent/check_mermaid.py"]
force-exclude = true
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = [
    "E", "W", "F", "I", "UP", "B", "SIM", "RUF", "D", "N", "PTH", "RET", "PT", "C4", "PIE",
    "DTZ", "TRY", "PERF", "NPY",
]
ignore = ["D100", "D104", "D105", "D107", "TRY003"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"**/tests/**" = ["D"]
"notebooks/**" = ["D", "E402", "B018"]
"docs/conf.py" = ["D"]

[tool.ty.src]
exclude = ["notebooks", "scripts/agent/deliver.py", "scripts/agent/cross_review.py", "scripts/agent/create_pr.py", "scripts/agent/pr_findings.py", "scripts/agent/check_mermaid.py"{% if infrastructure == "azure" %}, "infra"{% endif %}]

[tool.pytest.ini_options]
testpaths = ["apps/*/tests", "packages/*/tests"]
addopts = "--import-mode=importlib --cov --cov-report=term-missing -ra"
strict_markers = true
xfail_strict = true

[tool.coverage.run]
branch = true
source = ["apps", "packages"]
omit = ["*/tests/*", "*/dashboard.py"]

[tool.coverage.report]
fail_under = 80
show_missing = true
exclude_also = ["if TYPE_CHECKING:", "raise NotImplementedError", "\\.\\.\\."]

[tool.commitizen]
name = "cz_conventional_commits"
