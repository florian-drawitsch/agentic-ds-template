"""REST API entry point."""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from fastapi import FastAPI, HTTPException

REPORT_PATH = Path("data/08_reporting/latest.json")

app = FastAPI(title="{{ project_name }}")


@app.get("/health")
def health() -> dict[str, str]:
    """Report that the service is up."""
    return {"status": "ok"}


@app.get("/report")
def report() -> dict[str, Any]:
    """Return the latest pipeline report.

    Raises:
        HTTPException: 404 if the pipeline has not produced a report yet.
    """
    if not REPORT_PATH.is_file():
        raise HTTPException(status_code=404, detail="No report yet. Run the pipeline first.")
    return json.loads(REPORT_PATH.read_text(encoding="utf-8"))
