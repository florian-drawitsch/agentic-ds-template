"""Command line entry point: run pipelines and print the evaluation report."""

from __future__ import annotations

import argparse
{%- if config == 'hydra' %}
import itertools
{%- endif %}
import json
from collections.abc import Sequence
from pathlib import Path
{%- if config == 'python' %}
from typing import Any
{%- endif %}
{%- if config == 'hydra' %}
from typing import Any, cast

from hydra import compose, initialize_config_dir
from hydra.core.override_parser.overrides_parser import OverridesParser
from omegaconf import OmegaConf
{%- endif %}

from {{ package_name }}.catalog import Catalog
from {{ package_name }}.pipelines import PIPELINES
from {{ package_name }}.settings import Settings, {{ 'settings_from_mapping' if config == 'hydra' else 'load_settings' }}
from {{ package_name }}.tracking import {{ 'MlflowTracker' if tracking == 'mlflow' else 'NullTracker' }}, Tracker

CONFIG_DIR = Path(__file__).resolve().parents[2] / "conf"


def tracker_for(settings: Settings) -> Tracker:
    """Return the tracker the settings ask for."""
{%- if tracking == 'mlflow' %}
    tracking = settings.tracking
    return MlflowTracker(tracking.uri, tracking.experiment, tracking.artifact_dir)
{%- else %}
    del settings
    return NullTracker()
{%- endif %}


def run(settings: Settings, pipelines: Sequence[str]) -> dict[str, Any]:
    """Run the pipelines in order, track the run and return the evaluation report, if any."""
    catalog = Catalog(settings.catalog)
    produced: dict[str, Any] = {}
    for name in pipelines:
        produced |= PIPELINES[name].run(catalog, settings.params)
    report = produced.get("report", {})
    tracker_for(settings).record(
        params=dict(settings.params) | {"pipelines": ",".join(pipelines)},
        metrics={k: float(v) for k, v in report.items() if isinstance(v, int | float)},
        artifacts=[settings.catalog["report"]] if report and "report" in settings.catalog else [],
    )
    return report
{%- if config == 'hydra' %}


def compose_settings(overrides: Sequence[str]) -> Settings:
    """Compose the Hydra configuration with overrides into typed settings."""
    with initialize_config_dir(config_dir=str(CONFIG_DIR), version_base=None):
        cfg = compose(config_name="config", overrides=list(overrides))
    return settings_from_mapping(cast("dict[str, Any]", OmegaConf.to_container(cfg, resolve=True)))


def expand_sweep(overrides: Sequence[str]) -> list[list[str]]:
    """Expand comma-separated sweep values into one override list per combination."""
    choices = []
    for override in OverridesParser.create().parse_overrides(list(overrides)):
        key = override.get_key_element()
        if override.is_sweep_override():
            choices.append([f"{key}={value}" for value in override.sweep_string_iterator()])
        else:
            choices.append([f"{key}={override.get_value_element_as_str()}"])
    return [list(combination) for combination in itertools.product(*choices)]
{%- endif %}


def main(argv: list[str] | None = None) -> int:
    """Run the selected pipelines, all of them by default.
{%- if config == 'hydra' %}

    Hydra's compose API is used instead of `@hydra.main`, which fails on Python 3.14 with
    hydra-core 1.3.7.
    """
{%- else %}"""
{%- endif %}
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--pipeline",
        action="append",
        choices=list(PIPELINES),
        help="pipeline to run; repeat to run several (default: all, in order)",
    )
{%- if config == 'hydra' %}
    parser.add_argument("overrides", nargs="*", help="Hydra overrides, for example params.target=y")
    parser.add_argument(
        "-m", "--multirun", action="store_true", help="run every combination of a,b,c values"
    )
    args = parser.parse_args(argv)
    pipelines = args.pipeline or list(PIPELINES)
    for overrides in expand_sweep(args.overrides) if args.multirun else [args.overrides]:
        print(json.dumps(run(compose_settings(overrides), pipelines)))
{%- else %}
    parser.add_argument("--config", type=Path, default=CONFIG_DIR / "config.toml")
    args = parser.parse_args(argv)
    print(json.dumps(run(load_settings(args.config), args.pipeline or list(PIPELINES))))
{%- endif %}
    return 0
