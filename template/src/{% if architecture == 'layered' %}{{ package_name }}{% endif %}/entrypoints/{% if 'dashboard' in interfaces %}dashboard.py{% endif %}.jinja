"""Dashboard entry point. Run with `task dashboard`."""

from __future__ import annotations

import json
from pathlib import Path

import streamlit as st

REPORT_PATH = Path("data/reports/latest.json")

st.title("{{ project_name }}")
if REPORT_PATH.is_file():
    latest = json.loads(REPORT_PATH.read_text(encoding="utf-8"))
    st.metric("Mean absolute error", f"{latest['mae']:.3f}")
    st.json(latest)
else:
    st.info("No report yet. Run `task example-data` and `task run`.")
