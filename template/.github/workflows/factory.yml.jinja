{%- set o = '${{' -%}
{%- set vendors = (['claude', 'codex', 'gemini'] | select('in', agent_harnesses) | list)[:2] -%}
name: Factory

# Ticket factory (ADR-0033). The controller moves labeled issues to verified pull requests.
# All GitHub writes use FACTORY_GH_TOKEN so that the pull requests it opens start CI; the
# workflow's own token stays read-only. `task factory:secrets` sets the secrets. A board
# owned by a personal account needs a classic token with the repo, project and read:org scopes.
# Claude signs in with ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN (`claude setup-token`).
# Only the CLIs and secrets of the two configured vendors are used: {{ vendors | join(' and ') }}.

on:
  schedule:
    # Every hour, at minute 23 to avoid the top-of-hour load; this also polls the board for
    # cards moved to Ready. That is about 750 Actions minutes a month, well within the Free
    # plan's 2,000 for private repositories.
    - cron: '23 * * * *'
    - cron: '0 6 * * *'
    - cron: '0 7 * * 1'
  workflow_dispatch:
  issues:
    types: [labeled]

permissions:
  contents: read

jobs:
  tick:
    name: Tick
    if: >-
      github.event_name == 'workflow_dispatch'
      || (github.event_name == 'issues' && github.event.label.name == 'factory:ready')
      || (github.event_name == 'schedule' && github.event.schedule == '23 * * * *')
    # Job-level, so runs whose job is skipped (for example one started by the controller's own
    # labels) never join the group. GitHub keeps one waiting run per group and cancels older
    # waiting ones, so a workflow-level group let those runs cancel queued ticks.
    concurrency:
      group: factory
      cancel-in-progress: false
    runs-on: ubuntu-latest
    # The hosted-runner maximum. One tick runs at most one delivery; if the job is cut
    # off, the next tick resumes the saved run.
    timeout-minutes: 360
    steps:
      # Until `task factory:secrets` has run, skip quietly instead of failing every run.
      - name: Check secrets
        id: ready
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}{%- for v in vendors %}
{%- if v == 'claude' %}
          CLAUDE: {{ o }} secrets.ANTHROPIC_API_KEY || secrets.CLAUDE_CODE_OAUTH_TOKEN }}
{%- elif v == 'codex' %}
          CODEX: {{ o }} secrets.OPENAI_API_KEY }}
{%- else %}
          GEMINI: {{ o }} secrets.GEMINI_API_KEY }}
{%- endif %}
{%- endfor %}
        run: |
          if [ -n "$GH_TOKEN" ]{% for v in vendors %} && [ -n "${{ v | upper }}" ]{% endfor %}; then
            echo "ok=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::Factory secrets are missing; run task factory:secrets. Skipped."
          fi

      - name: Check out
        if: steps.ready.outputs.ok == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up uv
        if: steps.ready.outputs.ok == 'true'
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0

      - name: Set up Task
        if: steps.ready.outputs.ok == 'true'
        uses: go-task/setup-task@a00fbb05ce67b35648be3c78cbc9fd85354c757e # v2.2.0

      # Checkout keeps no credentials; this lets plain git commands push with the same token.
      - name: Set up git credentials
        if: steps.ready.outputs.ok == 'true'
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}
        run: gh auth setup-git

      - name: Install agent CLIs
        if: steps.ready.outputs.ok == 'true'
        # The CLIs have no lockfile here, so the versions are pinned exactly. Bump them by hand.
        run: npm install --global{% for v in vendors %} {{ {'claude': '@anthropic-ai/claude-code@2.1.329', 'codex': '@openai/codex@0.171.0', 'gemini': '@google/gemini-cli@0.70.0'}[v] }}{% endfor %}{% if 'gemini' in vendors %} @anthropic-ai/sandbox-runtime@0.0.83{% endif %} # zizmor: ignore[adhoc-packages]
{%- if 'gemini' in vendors %}

      # A Gemini implementer runs under srt (ADR-0034). The runner is throwaway, so weakening
      # Ubuntu's user-namespace hardening is acceptable here. Skipped unless factory.toml
      # selects Gemini as the implementer.
      - name: Prepare the sandbox
        if: steps.ready.outputs.ok == 'true'
        run: |
          grep -q '^harness = "gemini"' factory.toml || exit 0
          sudo apt-get install -y bubblewrap socat ripgrep
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          sudo apparmor_parser -R /etc/apparmor.d/bwrap-userns-restrict || true
          mkdir -p ~/.gemini ~/.cache ~/.npm /tmp/claude
{%- endif %}

      - name: Tick
        if: steps.ready.outputs.ok == 'true'
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}
{%- for v in vendors %}
{%- if v == 'claude' %}
          ANTHROPIC_API_KEY: {{ o }} secrets.ANTHROPIC_API_KEY }}
          CLAUDE_CODE_OAUTH_TOKEN: {{ o }} secrets.CLAUDE_CODE_OAUTH_TOKEN }}
{%- elif v == 'codex' %}
          OPENAI_API_KEY: {{ o }} secrets.OPENAI_API_KEY }}
          # `codex exec` reads only CODEX_API_KEY; OPENAI_API_KEY alone sends no credentials.
          CODEX_API_KEY: {{ o }} secrets.OPENAI_API_KEY }}
{%- else %}
          GEMINI_API_KEY: {{ o }} secrets.GEMINI_API_KEY }}
          # Headless runs exit with code 55 in an untrusted folder.
          GEMINI_CLI_TRUST_WORKSPACE: 'true'
{%- endif %}
{%- endfor %}
          SCHEDULED: {{ o }} github.event_name == 'schedule' && '--scheduled' || '' }}
        run: task factory:tick -- $SCHEDULED

  report-daily:
    name: Daily report
    if: github.event_name == 'schedule' && github.event.schedule == '0 6 * * *'
    runs-on: ubuntu-latest
    # Shares the tick's group: the retrospective writes to GitHub too.
    concurrency:
      group: factory
      cancel-in-progress: false
    timeout-minutes: 360
    steps:
      # Until `task factory:secrets` has run, skip quietly instead of failing every run.
      - name: Check secrets
        id: ready
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}{%- for v in vendors %}
{%- if v == 'claude' %}
          CLAUDE: {{ o }} secrets.ANTHROPIC_API_KEY || secrets.CLAUDE_CODE_OAUTH_TOKEN }}
{%- elif v == 'codex' %}
          CODEX: {{ o }} secrets.OPENAI_API_KEY }}
{%- else %}
          GEMINI: {{ o }} secrets.GEMINI_API_KEY }}
{%- endif %}
{%- endfor %}
        run: |
          if [ -n "$GH_TOKEN" ]{% for v in vendors %} && [ -n "${{ v | upper }}" ]{% endfor %}; then
            echo "ok=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::Factory secrets are missing; run task factory:secrets. Skipped."
          fi

      - name: Check out
        if: steps.ready.outputs.ok == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up uv
        if: steps.ready.outputs.ok == 'true'
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0

      - name: Set up Task
        if: steps.ready.outputs.ok == 'true'
        uses: go-task/setup-task@a00fbb05ce67b35648be3c78cbc9fd85354c757e # v2.2.0

      # Checkout keeps no credentials; this lets plain git commands push with the same token.
      - name: Set up git credentials
        if: steps.ready.outputs.ok == 'true'
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}
        run: gh auth setup-git

      - name: Install agent CLIs
        if: steps.ready.outputs.ok == 'true'
        # The CLIs have no lockfile here, so the versions are pinned exactly. Bump them by hand.
        run: npm install --global{% for v in vendors %} {{ {'claude': '@anthropic-ai/claude-code@2.1.329', 'codex': '@openai/codex@0.171.0', 'gemini': '@google/gemini-cli@0.70.0'}[v] }}{% endfor %}{% if 'gemini' in vendors %} @anthropic-ai/sandbox-runtime@0.0.83{% endif %} # zizmor: ignore[adhoc-packages]
{%- if 'gemini' in vendors %}

      # A Gemini implementer runs under srt (ADR-0034). The runner is throwaway, so weakening
      # Ubuntu's user-namespace hardening is acceptable here. Skipped unless factory.toml
      # selects Gemini as the implementer.
      - name: Prepare the sandbox
        if: steps.ready.outputs.ok == 'true'
        run: |
          grep -q '^harness = "gemini"' factory.toml || exit 0
          sudo apt-get install -y bubblewrap socat ripgrep
          sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
          sudo apparmor_parser -R /etc/apparmor.d/bwrap-userns-restrict || true
          mkdir -p ~/.gemini ~/.cache ~/.npm /tmp/claude
{%- endif %}

      - name: Daily report
        if: steps.ready.outputs.ok == 'true'
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}
        run: task factory:report -- daily

      # Runs the retrospective only when `retro_every` pull requests merged since the last
      # one; otherwise the controller prints the count and exits.
      - name: Retrospective
        if: steps.ready.outputs.ok == 'true'
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}
{%- for v in vendors %}
{%- if v == 'claude' %}
          ANTHROPIC_API_KEY: {{ o }} secrets.ANTHROPIC_API_KEY }}
          CLAUDE_CODE_OAUTH_TOKEN: {{ o }} secrets.CLAUDE_CODE_OAUTH_TOKEN }}
{%- elif v == 'codex' %}
          OPENAI_API_KEY: {{ o }} secrets.OPENAI_API_KEY }}
          # `codex exec` reads only CODEX_API_KEY; OPENAI_API_KEY alone sends no credentials.
          CODEX_API_KEY: {{ o }} secrets.OPENAI_API_KEY }}
{%- else %}
          GEMINI_API_KEY: {{ o }} secrets.GEMINI_API_KEY }}
          # Headless runs exit with code 55 in an untrusted folder.
          GEMINI_CLI_TRUST_WORKSPACE: 'true'
{%- endif %}
{%- endfor %}
        run: task factory:report -- retro

  report-weekly:
    name: Weekly report
    if: github.event_name == 'schedule' && github.event.schedule == '0 7 * * 1'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      # Until `task factory:secrets` has run, skip quietly instead of failing every run.
      - name: Check secrets
        id: ready
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}
{%- for v in vendors %}
          {{ v | upper }}: set
{%- endfor %}
        run: |
          if [ -n "$GH_TOKEN" ]{% for v in vendors %} && [ -n "${{ v | upper }}" ]{% endfor %}; then
            echo "ok=true" >> "$GITHUB_OUTPUT"
          else
            echo "::notice::Factory secrets are missing; run task factory:secrets. Skipped."
          fi

      - name: Check out
        if: steps.ready.outputs.ok == 'true'
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 0

      - name: Set up uv
        if: steps.ready.outputs.ok == 'true'
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0

      - name: Set up Task
        if: steps.ready.outputs.ok == 'true'
        uses: go-task/setup-task@a00fbb05ce67b35648be3c78cbc9fd85354c757e # v2.2.0

      - name: Weekly report
        if: steps.ready.outputs.ok == 'true'
        env:
          GH_TOKEN: {{ o }} secrets.FACTORY_GH_TOKEN }}
        run: task factory:report -- weekly
