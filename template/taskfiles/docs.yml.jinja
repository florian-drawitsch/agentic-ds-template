version: '3'

tasks:
  serve:
    desc: Serve the documentation with live reload at http://127.0.0.1:8000
    dir: '{{ '{{.ROOT_DIR}}' }}'
    cmds:
      - uv run --all-packages sphinx-autobuild docs docs/_build/html

  build:
    desc: Build the HTML documentation, treating warnings as errors
    dir: '{{ '{{.ROOT_DIR}}' }}'
    cmds:
      - uv run --all-packages sphinx-build -W --keep-going -b html docs docs/_build/html

  diagrams:
    desc: Generate package and class diagrams of the code as Mermaid with pyreverse
    dir: '{{ '{{.ROOT_DIR}}' }}'
    cmds:
      - mkdir -p docs/architecture/generated
      - for app in apps/*; do [ ! -d "$app/src" ] || uv run --all-packages pyreverse -o mmd -p "$(basename "$app")" -d docs/architecture/generated "$app/src"; done
