# Pipeline configuration, composed by Hydra. Override any value on the command line,
# for example `task run -- data.target=y`. Sweep with `task sweep -- data.target=a,b`.
data:
  path: data/raw/example.csv
  target: target
report_dir: data/reports
{%- if tracking == 'mlflow' %}
tracking:
  uri: sqlite:///data/tracking/mlflow.db
  experiment: {{ project_name }}
  artifact_dir: data/tracking/artifacts
{%- endif %}
