{#- Single source for agent permissions, rendered into Claude Code settings and Codex rules. -#}
{%- set allow_commands = [
  ["task"], ["uv", "run", "pytest"], ["uv", "run", "ruff"], ["uv", "run", "ty"],
  ["uv", "run", "lint-imports"], ["uv", "run", "--script", "scripts/agent"], ["uv", "sync"],
  ["uv", "add"], ["uv", "remove"], ["uv", "lock"], ["uv", "tree"],
  ["git", "status"], ["git", "diff"], ["git", "log"], ["git", "show"], ["git", "branch"],
  ["git", "switch"], ["git", "add"], ["git", "commit"], ["git", "worktree"], ["git", "rev-parse"],
  ["ls"], ["rg"], ["grep"], ["find"], ["head"], ["tail"], ["wc"], ["jq"],
] -%}
{%- set deny_commands = [
  {"cmd": ["git", "push", "--force"], "why": "Force pushes rewrite shared history."},
  {"cmd": ["git", "push", "-f"], "why": "Force pushes rewrite shared history."},
  {"cmd": ["git", "push", "--force-with-lease"], "why": "Force pushes rewrite shared history."},
  {"cmd": ["git", "commit", "--no-verify"], "why": "Git hooks must not be skipped."},
  {"cmd": ["pip", "install"], "why": "Use uv add instead of pip."},
  {"cmd": ["pip3", "install"], "why": "Use uv add instead of pip."},
  {"cmd": ["uv", "pip", "install"], "why": "Use uv add instead of pip."},
] -%}
{#- Read-only GitHub commands. They need the OS keychain, which the sandbox blocks. Commands that
    change GitHub state, such as `gh pr create`, still ask: `task deliver` publishes from its
    outer controller, outside any agent sandbox. -#}
{%- set keychain_commands = [
  ["gh", "auth", "status"], ["gh", "status"],
  ["gh", "pr", "view"], ["gh", "pr", "list"], ["gh", "pr", "diff"], ["gh", "pr", "checks"],
  ["gh", "pr", "status"], ["gh", "issue", "view"], ["gh", "issue", "list"],
  ["gh", "run", "view"], ["gh", "run", "list"], ["gh", "run", "watch"],
] -%}
